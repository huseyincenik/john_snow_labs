# Auto detect text files and perform LF normalization
* text=auto

# Python files should use LF
*.py text eol=lf
*.pyx text eol=lf

# Shell scripts should use LF
*.sh text eol=lf

# Windows scripts should use CRLF
*.bat text eol=crlf
*.ps1 text eol=crlf
*.cmd text eol=crlf

# Markdown and documentation
*.md text eol=lf
*.txt text eol=lf

# Docker and config files
Dockerfile text eol=lf
docker-compose.yml text eol=lf
.dockerignore text eol=lf
.gitignore text eol=lf
.env* text eol=lf

# JSON, YAML, TOML
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf

# Binary files
*.pdf binary
*.docx binary
*.jpg binary
*.png binary
*.gif binary
*.ico binary
*.pyc binary

