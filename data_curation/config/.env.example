########################################
# Data Curation Service - Sample .env  #
########################################

# -------- LLM Providers --------
DEFAULT_LLM_PROVIDER=openai

# OpenAI (cloud)
OPENAI_API_KEY=sk-your-openai-key
OPENAI_MODEL=gpt-4o-mini

# Qwen / Open-Source (OpenAI-compatible endpoint)
QWEN_API_BASE=http://localhost:11435/v1
QWEN_PORT=11435
QWEN_API_KEY=qwen-local-key
QWEN_MODEL=qwen2.5:0.5b-instruct

# Local Gemma/Qwen served via OpenAI-compatible API (e.g., LM Studio, Ollama)
LOCAL_API_BASE=http://localhost:1234/v1
LOCAL_API_KEY=local-key
LOCAL_MODEL_NAME=gemma-2b-it
USE_LOCAL_LLM=false

# -------- Storage & Logging --------
STORAGE_TYPE=json
OUTPUT_DIR=./data/output
LOG_DIR=./logs

# -------- Database (optional) --------
USE_POSTGRES=false
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=data_curation
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# -------- Concurrency --------
MAX_CONCURRENT_REQUESTS=5
MAX_WORKERS=10

# -------- API --------
API_HOST=0.0.0.0
API_PORT=8000
API_RELOAD=true
